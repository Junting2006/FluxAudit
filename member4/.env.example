# ===== FluxAudit 成员4 后端环境变量模板 =====
# 复制为 .env 后按需填写；不填则默认走 Mock（保证 Demo 100% 跑通）。

# 全局兜底：true 时自动切入静态 JSON 数据源，防 AI 超时 / 链上 API 限流
USE_MOCK_DATA=true

# 是否默认走成员3 的 LLM（可按任务覆盖）
USE_LLM=false

# 链 ID（Sepolia 测试网）
CHAIN_ID=11155111

# Etherscan API Key（有则真实拉取合约源码/验证状态，否则 Mock）
ETHERSCAN_API_KEY=

# Alchemy API Key / RPC（预留，用于后续真实持币分布）
ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=

# 成员3 模块路径（指向 member3/ 目录）；不填则尝试 ../member3
MEMBER3_PATH=

# 报告模型版本号
MODEL_VERSION=FluxAudit-Backend-v1

# 服务端口
PORT=8000

# 允许访问后端的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
